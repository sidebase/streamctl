exports[`render baseline: app preset > .github/workflows/pipeline.yml > aptPackages 1`] = `
"name: pipeline
on:
  pull_request:
env:
  NODE_VERSION: "20.9.0"
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: \${{ env.NODE_VERSION }}
      - run: acme build
"
`;

exports[`render baseline: app preset > .github/workflows/pipeline.yml > ci.all-jobs 1`] = `
"name: pipeline
on:
  pull_request:
env:
  NODE_VERSION: "20.9.0"
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: \${{ env.NODE_VERSION }}
      - run: acme build
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: \${{ env.NODE_VERSION }}
      - run: acme lint
  smoke:
    runs-on: ubuntu-latest
    services:
      registry:
        image: registry:2
    steps:
      - uses: actions/checkout@v4
      - run: acme smoke
"
`;

