exports[`render baseline: base preset > .github/workflows/acme-upgrade.yml > aptPackages 1`] = `
"name: acme upgrade
on:
  schedule:
    - cron: "0 6 * * 1"
jobs:
  upgrade:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20.9.0"
      - run: acme upgrade --yes
"
`;

